rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSurvey(data) {
      return data.keys().hasAll(['selectedCourses', 'submittedAt']) &&
             data.keys().hasOnly(['selectedCourses', 'submittedAt']) &&
             data.selectedCourses is list &&
             data.selectedCourses.size() > 0 &&
             data.selectedCourses.size() <= 100 &&
             data.submittedAt is string &&
             data.submittedAt.size() <= 50;
    }

    match /surveys/{surveyId} {
      // 학생 누구나 로그인 없이 희망 과목 설문 응답 제출 가능
      allow create: if isValidSurvey(request.resource.data);

      // 관리자 통계 화면 및 학생 완료 화면에서 집계를 위한 읽기 허용 (개인정보 미포함 데이터)
      allow read: if true;

      // 관리자 화면에서 설문 항목 정리 및 삭제 허용
      allow delete: if true;

      // 제출된 설문 데이터의 사후 임의 수정은 금지
      allow update: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
